<title>主様の雪だるままつり</title>

<style>

/* =========================
   全体
   ========================= */

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 0;

  font-family:
    "Hiragino Kaku Gothic ProN",
    "Yu Gothic",
    "Meiryo",
    sans-serif;

  color: #526477;

  background:
    linear-gradient(
      180deg,
      #cfeeff 0%,
      #eaf8ff 45%,
      #ffffff 100%
    );

  line-height: 1.8;
}


/* =========================
   雪
   ========================= */

.snow {
  position: fixed;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 10;
}

.snow span {
  position: absolute;
  top: -20px;

  color: rgba(255, 255, 255, 0.9);
  font-size: 18px;

  animation: fall linear infinite;
}

.snow span:nth-child(1) {
  left: 8%;
  animation-duration: 9s;
}

.snow span:nth-child(2) {
  left: 22%;
  animation-duration: 12s;
  animation-delay: 2s;
}

.snow span:nth-child(3) {
  left: 38%;
  animation-duration: 10s;
  animation-delay: 4s;
}

.snow span:nth-child(4) {
  left: 55%;
  animation-duration: 14s;
  animation-delay: 1s;
}

.snow span:nth-child(5) {
  left: 72%;
  animation-duration: 11s;
  animation-delay: 3s;
}

.snow span:nth-child(6) {
  left: 88%;
  animation-duration: 13s;
  animation-delay: 5s;
}

@keyframes fall {
  0% {
    transform: translateY(-30px) rotate(0deg);
    opacity: 0;
  }

  10% {
    opacity: 1;
  }

  100% {
    transform: translateY(110vh) rotate(180deg);
    opacity: 0.5;
  }
}


/* =========================
   メイン
   ========================= */

.container {
  width: min(900px, calc(100% - 32px));
  margin: 0 auto;
}


/* =========================
   ヘッダー
   ========================= */

.hero {
  position: relative;

  text-align: center;

  padding: 80px 20px 70px;

  overflow: hidden;
}

.hero::before {
  content: "✦";
  position: absolute;

  top: 45px;
  left: 15%;

  color: #f4c95d;
  font-size: 28px;

  animation: twinkle 2s ease-in-out infinite;
}

.hero::after {
  content: "✦";
  position: absolute;

  top: 95px;
  right: 16%;

  color: #f4c95d;
  font-size: 20px;

  animation: twinkle 2.5s ease-in-out infinite;
}

@keyframes twinkle {
  0%, 100% {
    opacity: 0.35;
    transform: scale(0.8);
  }

  50% {
    opacity: 1;
    transform: scale(1.2);
  }
}

.hero-decoration {
  color: #9ed8f5;
  font-size: 28px;
  letter-spacing: 12px;
  margin-bottom: 15px;
}

.hero h1 {
  margin: 0;

  color: #4b9dcc;

  font-size: clamp(28px, 6vw, 48px);
  font-weight: bold;

  text-shadow:
    2px 2px 0 #ffffff,
    0 3px 10px rgba(76, 145, 190, 0.18);
}

.hero-subtitle {
  margin-top: 15px;

  color: #788b9b;
  font-size: 14px;
  letter-spacing: 0.12em;
}


/* =========================
   雪山・雪原っぽい装飾
   ========================= */

.snow-ground {
  position: relative;

  height: 30px;
  margin-bottom: 35px;

  background: #ffffff;

  border-radius: 50% 50% 0 0 / 100% 100% 0 0;

  box-shadow:
    0 -5px 15px rgba(100, 180, 220, 0.12);
}


/* =========================
   セクション
   ========================= */

.section {
  position: relative;

  margin-bottom: 30px;
  padding: 30px 32px;

  background: rgba(255, 255, 255, 0.88);

  border: 1px solid rgba(142, 207, 239, 0.55);

  border-radius: 18px;

  box-shadow:
    0 8px 25px rgba(76, 145, 190, 0.10);
}

.section h2 {
  display: flex;
  align-items: center;
  gap: 10px;

  margin: 0 0 20px;

  color: #4b9dcc;

  font-size: 21px;
}

.section h2::before {
  content: "❄";

  color: #f0c44f;
  font-size: 20px;
}

.section p {
  margin: 0 0 15px;
}

.section p:last-child {
  margin-bottom: 0;
}


/* =========================
   強調
   ========================= */

.highlight {
  margin: 20px 0;
  padding: 18px 20px;

  background: #f4fbff;

  border-left: 5px solid #f3c95b;

  border-radius: 8px;
}

.highlight strong {
  color: #438fbd;
}


/* =========================
   参加方法
